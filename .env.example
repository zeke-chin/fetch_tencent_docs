# Copy to .env and fill in real values:
#   cp .env.example .env
#
# Supported aliases (any one works):
#   jina_key  / JINA_API_KEY  / JINA_KEY
#   tavily_key / TAVILY_API_KEY / TAVILY_KEY

# Jina Reader (optional; free tier works without a key)
# https://jina.ai/reader/
jina_key=jina_xxxxxxxx

# Tavily Extract (required only when using --backend tavily)
# https://tavily.com/
tavily_key=tvly-xxxxxxxx
